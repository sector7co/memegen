{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memegen-internal",
  "main": "index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "../client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memegen",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "../../drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "memegen-files"
    }
  ]
}
